# PA - Mnemosyne
# Copy this file to .env and fill in your credentials

# ServerChan (WeChat push notifications)
# Get your SendKey at: https://sct.ftqq.com/
SERVERCHAN_SENDKEY=

# Feishu / Lark (optional, for meeting notes integration)
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# Notion Integration Token (for knowledge base integration)
# Create at: https://www.notion.so/my-integrations
NOTION_TOKEN=
